<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>Meine Todos</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<main>
    <h1>Meine Todos</h1>
    <h2> Neues Todo anlegen </h2>


    <form action="/newtodo" method="post">
        <div>
            <label for="todo">Text:</label>

            <input
                id="todo"
                name="todo"
                type="text"
            >
        </div>

        <button type="submit">
           Neues Todo erstellen
        </button>
    </form>

    <h2>Offene Todos</h2>
		<form action="/closetodo" method="post">
            <ul>
                <% openTodos.forEach(todo => { %>
                    <li>
						<input type="checkbox"  name="todo" value="<%= todo %>"">
						<label> <%= todo %></label>
					</li>
                <% }); %>
            </ul>

            <button type="submit">
                Todo erledigt
            </button>
		</form>

    <h2>Erledigte Todos</h2>
        <ul>
			<% closedTodos.forEach(todo => { %>
                <li> <%= todo %> </li>
            <% }); %>
        </ul>

</main>

</body>
</html>