<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>Meine Todos</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<main>
    <h1>Meine Todos</h1>
    <h2> Neues Todo anlegen </h2>


    <form action="/newtodo" method="post">
        <div>
            <label for="todo">Text:</label>

            <input
                id="todo"
                name="todo"
                type="text"
            >
        </div>

        <button type="submit">
           Neues Todo erstellen
        </button>
    </form>

    <h2>Offene Todos</h2>
        <ul>
            <% openTodos.forEach(todo => { %>
                <li><input type="checkbox"><label> <%= todo %></label></li>
            <% }); %>
        </ul>

        <button type="submit">
           Todo erledigt
        </button>

    <h2>Erledigte Todos</h2>
        <ul>
			<% closedTodos.forEach(todo => { %
                <li>
					<input type="checkbox">
					<label> <%= todo %></label>
				</li>
            <% }); %>
        </ul>

</main>

</body>
</html>